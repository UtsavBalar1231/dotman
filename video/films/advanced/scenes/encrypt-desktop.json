{
  "on": "desktop",
  "cols": 100,
  "rows": 24,
  "steps": [
    {"say": "# desktop: no key here yet"},
    {"run": "dotman sync"},
    {"say": "# import a copy of the laptop's key"},
    {"run": "dotman key import /srv/age-key.txt"},
    {"run": "dotman sync"},
    {"run": "cat ~/.ssh/config"},
    {"wait": 1}
  ]
}
