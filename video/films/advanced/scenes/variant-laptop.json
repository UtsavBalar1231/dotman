{
  "on": "laptop",
  "cols": 100,
  "rows": 24,
  "steps": [
    {"hidden": "mkdir -p ~/.config && printf 'monitor = eDP-1, 2880x1800@90, 0x0, 1.5\\n' > ~/.config/monitors.conf"},
    {"say": "# laptop: this monitor layout fits only the laptop"},
    {"run": "dotman add --for host=laptop ~/.config/monitors.conf"},
    {"run": "dotman sync"},
    {"wait": 1}
  ]
}
