{
  "on": "laptop",
  "cols": 100,
  "rows": 24,
  "steps": [
    {"hidden": "git init -q --bare -b main /srv/dotfiles.git"},
    {"hidden": "printf 'export EDITOR=nvim\\nalias ll=\"ls -l\"\\n' > ~/.zshrc && mkdir -p ~/.config/nvim && printf 'vim.o.number = true\\nvim.o.relativenumber = true\\n' > ~/.config/nvim/init.lua"},
    {"say": "# your laptop: start a dotfiles repo"},
    {"run": "dotman init", "answers": [
      ["user.name", "Alex\r"],
      ["user.email", "alex@example.com\r"],
      ["globally", "y\r"],
      ["Choose 1-3", "1\r"],
      ["Remote URL", "file:///srv/dotfiles.git\r"],
      ["Host name", "\r"],
      ["Profiles", "\r"],
      ["system files", "n\r"],
      ["age key", "n\r"]
    ]},
    {"run": "dotman add ~/.zshrc ~/.config/nvim", "answers": [["files? [y/N]", "y\r"]]},
    {"run": "dotman sync"},
    {"wait": 1}
  ]
}
