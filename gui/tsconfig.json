{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "verbatimModuleSyntax": true,
    "noEmitOnError": true,
    "rootDir": "frontend",
    "outDir": "dist"
  },
  "include": ["frontend/**/*.ts"]
}
