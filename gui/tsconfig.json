{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "strict": true,
    "verbatimModuleSyntax": true,
    "noEmitOnError": true,
    "rootDir": "frontend",
    "noEmit": true
  },
  "include": ["frontend/**/*.ts", "frontend/**/*.tsx"]
}
