
use builtin;
use str;

set edit:completion:arg-completer[dotman] = {|@words|
    fn spaces {|n|
        builtin:repeat $n ' ' | str:join ''
    }
    fn cand {|text desc|
        edit:complex-candidate $text &display=$text' '(spaces (- 14 (wcswidth $text)))$desc
    }
    var command = 'dotman'
    for word $words[1..-1] {
        if (str:has-prefix $word '-') {
            break
        }
        set command = $command';'$word
    }
    var completions = [
        &'dotman'= {
            cand -v 'Show verbose output'
            cand --verbose 'Show verbose output'
            cand -q 'Suppress informational messages'
            cand --quiet 'Suppress informational messages'
            cand --no-pager 'Disable pager output'
            cand --allow-root 'Allow running as root'
            cand -h 'Print help'
            cand --help 'Print help'
            cand -V 'Print version'
            cand --version 'Print version'
            cand init 'Create the dotman repo or set its remote, or clone a repo and apply it'
            cand add 'Start managing files or directories'
            cand forget 'Stop managing files or directories, keeping them in $HOME'
            cand list 'List the managed files'
            cand status 'Compare $HOME, the repo and the last applied state'
            cand apply 'Write the repo''s files into $HOME'
            cand diff 'Show how $HOME differs from the repo'
            cand edit 'Open a managed file''s source in $VISUAL or $EDITOR, then apply it'
            cand sync 'Capture local changes, commit, pull, apply what arrived and push'
            cand log 'Show the repo''s history'
            cand restore 'Write an earlier version of a file into $HOME, keeping the current one as a backup'
            cand import 'Convert another setup into the repo, or add what the repo lacks from one'
            cand git 'Run git in the repo'
            cand doctor 'Check the environment and the repo for problems'
            cand key 'Create or import the age identity that decrypts encrypted files'
            cand completion 'Generate shell completion scripts'
            cand system-write 'Write the system files a plan names; `apply --system` starts it through sudo, doas or run0'
        }
        &'dotman;init'= {
            cand --remote 'Set or replace the `origin` remote'
            cand --git-name 'Git `user.name` to set when git has no identity'
            cand --git-email 'Git `user.email` to set when git has no identity'
            cand --create-github 'Create the private GitHub repo `OWNER/NAME` with `gh` and make it `origin`'
            cand --host 'Host name of this machine, written to `[identity]` in the machine config'
            cand --profile 'A profile this machine opts into, written to the machine config; repeatable'
            cand --system-root 'A directory outside $HOME whose files this machine manages, added to `[system] roots`; repeatable'
            cand --age-key-file 'Import the age identity in FILE before applying, so encrypted files decrypt'
            cand --no-import 'Create a fresh repo without looking for an existing setup to import'
            cand --keep-local 'Keep the local version of files that differ from the repo'
            cand --take-repo 'Take the repo version of files that differ, after backing them up'
            cand --approve-hooks 'Approve the `[hooks]` table of the cloned repo on this machine and run its hooks'
            cand --dry-run 'Show what would be created and change nothing'
            cand --no-bootstrap 'Do not write install.sh, the script that sets up `dotman` in a container'
            cand --refresh-bootstrap 'Rewrite install.sh with this version''s script, unless it was edited'
            cand --git-global 'Store --git-name and --git-email in the global git config instead of the repo''s'
            cand --no-remote 'Do not ask for a remote'
            cand --no-system 'Do not ask about system files'
            cand --create-key 'Create an age identity for encrypted files'
            cand --no-key 'Do not ask about an age identity'
            cand --force 'With --age-key-file: replace a different existing identity, after backing it up'
            cand -v 'Show verbose output'
            cand --verbose 'Show verbose output'
            cand -q 'Suppress informational messages'
            cand --quiet 'Suppress informational messages'
            cand --no-pager 'Disable pager output'
            cand --allow-root 'Allow running as root'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'dotman;add'= {
            cand --for 'Add the files as variants that apply only where these `+`-joined conditions hold, such as `host=laptop+os!=macos`'
            cand --encrypt 'Store the files encrypted to the `[age] recipients` in .dotman.toml'
            cand --allow-plain 'Add files in plain text although their names match `[guard] secret_names` and the remote is public'
            cand --yes 'Do not ask before adding directories'
            cand --dry-run 'Show what would be added and change nothing'
            cand --system 'Add regular files outside $HOME that you can read, such as /etc/keyd/default.conf'
            cand --package-owned 'With --system: the file belongs to a package; manage it anyway'
            cand --add-root 'With --system: add the top-level directory to `[system] roots` without asking'
            cand -v 'Show verbose output'
            cand --verbose 'Show verbose output'
            cand -q 'Suppress informational messages'
            cand --quiet 'Suppress informational messages'
            cand --no-pager 'Disable pager output'
            cand --allow-root 'Allow running as root'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'dotman;forget'= {
            cand --dry-run 'Show what would be forgotten and change nothing'
            cand -v 'Show verbose output'
            cand --verbose 'Show verbose output'
            cand -q 'Suppress informational messages'
            cand --quiet 'Suppress informational messages'
            cand --no-pager 'Disable pager output'
            cand --allow-root 'Allow running as root'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'dotman;list'= {
            cand --porcelain 'Print `<kind>\t<key>\0` records'
            cand -v 'Show verbose output'
            cand --verbose 'Show verbose output'
            cand -q 'Suppress informational messages'
            cand --quiet 'Suppress informational messages'
            cand --no-pager 'Disable pager output'
            cand --allow-root 'Allow running as root'
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
        }
        &'dotman;status'= {
            cand --porcelain 'Print `<status>\t<key>\0` records for every managed path'
            cand -v 'Show verbose output'
            cand --verbose 'Show verbose output'
            cand -q 'Suppress informational messages'
            cand --quiet 'Suppress informational messages'
            cand --no-pager 'Disable pager output'
            cand --allow-root 'Allow running as root'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'dotman;apply'= {
            cand --keep-local 'Keep the local version of conflicting and existing files'
            cand --take-repo 'Take the repo version of conflicting and existing files, after backing them up'
            cand --forget-deleted 'Stop managing files deleted locally; they stay deleted'
            cand --restore-deleted 'Write files deleted locally back from the repo'
            cand --accept-identity 'Accept a changed machine identity and use the variants it selects'
            cand --approve-hooks 'Approve the current `[hooks]` table on this machine and run its hooks'
            cand --in-place 'Rewrite files in place when a rename cannot replace them, as on a bind mount'
            cand --no-hooks 'Run no hooks'
            cand --dry-run 'Show what would be written and change nothing'
            cand --system 'Also write the system files outside $HOME, through one sudo, doas or run0 call'
            cand --yes 'With --system: write the system files without asking'
            cand -v 'Show verbose output'
            cand --verbose 'Show verbose output'
            cand -q 'Suppress informational messages'
            cand --quiet 'Suppress informational messages'
            cand --no-pager 'Disable pager output'
            cand --allow-root 'Allow running as root'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'dotman;diff'= {
            cand -v 'Show verbose output'
            cand --verbose 'Show verbose output'
            cand -q 'Suppress informational messages'
            cand --quiet 'Suppress informational messages'
            cand --no-pager 'Disable pager output'
            cand --allow-root 'Allow running as root'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'dotman;edit'= {
            cand -v 'Show verbose output'
            cand --verbose 'Show verbose output'
            cand -q 'Suppress informational messages'
            cand --quiet 'Suppress informational messages'
            cand --no-pager 'Disable pager output'
            cand --allow-root 'Allow running as root'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'dotman;sync'= {
            cand -m 'Commit message, replacing the generated `sync(<host>): ...` line'
            cand --message 'Commit message, replacing the generated `sync(<host>): ...` line'
            cand --keep-local 'Keep the local version of conflicting and existing files'
            cand --take-repo 'Take the repo version of conflicting and existing files, after backing them up'
            cand --forget-deleted 'Stop managing files deleted locally; they stay deleted'
            cand --restore-deleted 'Write files deleted locally back from the repo'
            cand --accept-identity 'Accept a changed machine identity and use the variants it selects'
            cand --approve-hooks 'Approve the current `[hooks]` table on this machine and run its hooks'
            cand --no-hooks 'Run no hooks'
            cand --dry-run 'Show what would be captured, committed, pulled, applied and pushed; change nothing'
            cand --system 'After the pull, also write the system files outside $HOME, through one sudo, doas or run0 call'
            cand --yes 'With --system: write the system files without asking'
            cand --allow-mass-delete 'Commit even when the repo changes delete at least half of the tracked files (10 or more)'
            cand -v 'Show verbose output'
            cand --verbose 'Show verbose output'
            cand -q 'Suppress informational messages'
            cand --quiet 'Suppress informational messages'
            cand --no-pager 'Disable pager output'
            cand --allow-root 'Allow running as root'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'dotman;log'= {
            cand -n 'Show at most this many commits'
            cand --max-count 'Show at most this many commits'
            cand -v 'Show verbose output'
            cand --verbose 'Show verbose output'
            cand -q 'Suppress informational messages'
            cand --quiet 'Suppress informational messages'
            cand --no-pager 'Disable pager output'
            cand --allow-root 'Allow running as root'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'dotman;restore'= {
            cand --from 'Revision or date to restore from; `HEAD` when omitted'
            cand --dry-run 'Show what would be written and change nothing'
            cand -v 'Show verbose output'
            cand --verbose 'Show verbose output'
            cand -q 'Suppress informational messages'
            cand --quiet 'Suppress informational messages'
            cand --no-pager 'Disable pager output'
            cand --allow-root 'Allow running as root'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'dotman;import'= {
            cand --overlay 'Add what SOURCE has and the repo lacks as one commit: modes, and with `--include-missing` files'
            cand --include-missing 'With `--overlay`, add the files the repo lacks without asking'
            cand --render-templates 'For a chezmoi source, run its templates and import this host''s rendering'
            cand --swap 'Replace the symlinks of an imported farm with real files holding the same bytes'
            cand --yes 'Do not ask before writing'
            cand --no-bootstrap 'Do not write install.sh, the script that sets up `dotman` in a container'
            cand --dry-run 'Show the report and change nothing'
            cand -v 'Show verbose output'
            cand --verbose 'Show verbose output'
            cand -q 'Suppress informational messages'
            cand --quiet 'Suppress informational messages'
            cand --no-pager 'Disable pager output'
            cand --allow-root 'Allow running as root'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'dotman;git'= {
            cand -v 'Show verbose output'
            cand --verbose 'Show verbose output'
            cand -q 'Suppress informational messages'
            cand --quiet 'Suppress informational messages'
            cand --no-pager 'Disable pager output'
            cand --allow-root 'Allow running as root'
        }
        &'dotman;doctor'= {
            cand --online 'Also ask the remote with `git ls-remote`'
            cand -v 'Show verbose output'
            cand --verbose 'Show verbose output'
            cand -q 'Suppress informational messages'
            cand --quiet 'Suppress informational messages'
            cand --no-pager 'Disable pager output'
            cand --allow-root 'Allow running as root'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'dotman;key'= {
            cand -v 'Show verbose output'
            cand --verbose 'Show verbose output'
            cand -q 'Suppress informational messages'
            cand --quiet 'Suppress informational messages'
            cand --no-pager 'Disable pager output'
            cand --allow-root 'Allow running as root'
            cand -h 'Print help'
            cand --help 'Print help'
            cand init 'Generate an age identity and add its recipient to .dotman.toml'
            cand import 'Copy an existing age identity into place and check that its recipient is listed'
        }
        &'dotman;key;init'= {
            cand -v 'Show verbose output'
            cand --verbose 'Show verbose output'
            cand -q 'Suppress informational messages'
            cand --quiet 'Suppress informational messages'
            cand --no-pager 'Disable pager output'
            cand --allow-root 'Allow running as root'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'dotman;key;import'= {
            cand --add-recipient 'Add the identity''s recipient to `[age] recipients` in .dotman.toml if it is missing'
            cand --force 'Replace an existing, different identity, after backing it up'
            cand -v 'Show verbose output'
            cand --verbose 'Show verbose output'
            cand -q 'Suppress informational messages'
            cand --quiet 'Suppress informational messages'
            cand --no-pager 'Disable pager output'
            cand --allow-root 'Allow running as root'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'dotman;completion'= {
            cand -v 'Show verbose output'
            cand --verbose 'Show verbose output'
            cand -q 'Suppress informational messages'
            cand --quiet 'Suppress informational messages'
            cand --no-pager 'Disable pager output'
            cand --allow-root 'Allow running as root'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'dotman;system-write'= {
            cand --plan 'The plan file that `apply --system` wrote'
            cand -v 'Show verbose output'
            cand --verbose 'Show verbose output'
            cand -q 'Suppress informational messages'
            cand --quiet 'Suppress informational messages'
            cand --no-pager 'Disable pager output'
            cand --allow-root 'Allow running as root'
            cand -h 'Print help'
            cand --help 'Print help'
        }
    ]
    $completions[$command]
}
