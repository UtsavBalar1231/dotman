# Maintainer: Utsav Balar <utsavbalar1231@gmail.com>

pkgname=dotman-cli
pkgver=0.1.0
pkgrel=1
pkgdesc="Dotfiles manager with git-like semantics"
arch=('x86_64' 'aarch64')
url="https://github.com/UtsavBalar1231/dotman"
license=('MIT')
depends=('gcc-libs' 'glibc')
makedepends=('rust' 'cargo' 'help2man')
source=("$pkgname-$pkgver.tar.gz::https://github.com/UtsavBalar1231/dotman/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')  # Updated by CI/release workflow

prepare() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --release --locked --all-features
}

check() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo test --release --locked --all-features
}

package() {
    cd "$pkgname-$pkgver"

    # Only dotman: /usr/bin/dot belongs to Graphviz, so no dot alias is packaged
    install -Dm755 target/release/dotman "$pkgdir/usr/bin/dotman"

    # Install documentation
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"

    # Install license
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE" 2>/dev/null || \
        echo "MIT" > "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

    # Generate and install shell completions
    mkdir -p "$pkgdir/usr/share/bash-completion/completions"
    ./target/release/dotman completion bash > "$pkgdir/usr/share/bash-completion/completions/dotman"

    mkdir -p "$pkgdir/usr/share/zsh/site-functions"
    ./target/release/dotman completion zsh > "$pkgdir/usr/share/zsh/site-functions/_dotman"

    mkdir -p "$pkgdir/usr/share/fish/vendor_completions.d"
    ./target/release/dotman completion fish > "$pkgdir/usr/share/fish/vendor_completions.d/dotman.fish"

    # Generate and install man page
    mkdir -p "$pkgdir/usr/share/man/man1"
    help2man --no-info --name="dotfiles manager" \
        --version-string="$pkgver" ./target/release/dotman > "$pkgdir/usr/share/man/man1/dotman.1"
}
