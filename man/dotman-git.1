.ie \n(.g .ds Aq \(aq
.el .ds Aq '
.TH dotman-git 1  "git "
.SH NAME
dotman\-git \- Run git in the repo
.SH SYNOPSIS
\fBdotman git\fR [\fB\-v\fR|\fB\-\-verbose\fR] [\fB\-q\fR|\fB\-\-quiet\fR] [\fB\-\-no\-pager\fR] [\fB\-\-allow\-root\fR] [\fIARGS\fR]
.SH DESCRIPTION
Run git in the repo
.SH OPTIONS
.TP
[\fIARGS\fR]
Passed to git as given
.SH "GLOBAL OPTIONS"
.TP
\fB\-v\fR, \fB\-\-verbose\fR
Show verbose output
.TP
\fB\-q\fR, \fB\-\-quiet\fR
Suppress informational messages
.TP
\fB\-\-no\-pager\fR
Disable pager output
.TP
\fB\-\-allow\-root\fR
Allow running as root
