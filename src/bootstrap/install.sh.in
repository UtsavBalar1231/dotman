#!/bin/sh
set -eu

pinned=@VERSION@
base=${DOTMAN_BOOTSTRAP_BASE_URL:-https://github.com/UtsavBalar1231/dotman/releases/download/v$pinned}
dir=$(cd "$(dirname "$0")" && pwd)
bin_dir=$HOME/.local/bin

die() {
    printf 'install.sh: %s\n' "$*" >&2
    exit 1
}

tmp=
said_file=
staged=
trap 'rm -rf ${tmp:+"$tmp"} ${said_file:+"$said_file"} ${staged:+"$staged"}' EXIT
# dash runs no EXIT trap when a signal kills it, so each of these exits, with the status the
# signal would have given, through the EXIT trap.
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

# A TMPDIR that is missing or not writable falls back to /tmp.
make_temp() {
    mktemp "$@" 2>/dev/null || TMPDIR=/tmp mktemp "$@"
}

# Sets major, minor and patch. Strict because other tools ship a `dotman` or a `dot` (Graphviz):
# anything that is not exactly X.Y.Z, with an optional -pre or +build suffix, is not this dotman.
parse_semver() {
    core=${1%%[-+]*}
    case $core in
        '' | *[!0-9.]* | .* | *. | *..*) return 1 ;;
        *.*.*) ;;
        *) return 1 ;;
    esac
    major=${core%%.*}
    rest=${core#*.}
    minor=${rest%%.*}
    patch=${rest#*.}
    case $patch in
        *.*) return 1 ;;
    esac
}

at_least_pinned() {
    if [ "$major" -ne "$want_major" ]; then
        [ "$major" -gt "$want_major" ]
        return
    fi
    if [ "$minor" -ne "$want_minor" ]; then
        [ "$minor" -gt "$want_minor" ]
        return
    fi
    [ "$patch" -ge "$want_patch" ]
}

is_current_dotman() {
    [ -x "$1" ] || return 1
    out=$("$1" --version 2>/dev/null </dev/null) || return 1
    case $out in
        "dotman "*) ;;
        *) return 1 ;;
    esac
    parse_semver "${out#dotman }" && at_least_pinned
}

fetch() {
    if command -v curl >/dev/null 2>&1; then
        curl -fsSL -o "$2" "$1"
    elif command -v wget >/dev/null 2>&1; then
        wget -qO "$2" "$1"
    else
        die "neither curl nor wget is installed"
    fi
}

verify() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum -c expected
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 -c expected
    else
        echo "neither sha256sum nor shasum is installed" >&2
        return 1
    fi
}

install_dotman() {
    case $(uname -s) in
        Linux) ;;
        Darwin)
            cat <<EOM
dotman is not installed. Download the macOS build from
  https://github.com/UtsavBalar1231/dotman/releases/tag/v$pinned
put it on your PATH, then run:
  dotman init "$dir" --take-repo
EOM
            exit 0
            ;;
        *) die "unsupported platform $(uname -s); build dotman from source and run: dotman init \"$dir\" --take-repo" ;;
    esac
    case $(uname -m) in
        x86_64 | amd64) arch=x86_64 ;;
        aarch64 | arm64) arch=aarch64 ;;
        *) die "unsupported architecture $(uname -m)" ;;
    esac

    archive=dotman-v$pinned-$arch-unknown-linux-musl.tar.gz
    tmp=$(make_temp -d) || die "cannot create a temp directory"
    fetch "$base/$archive" "$tmp/$archive" || die "cannot download $base/$archive"
    fetch "$base/checksums.txt" "$tmp/checksums.txt" || die "cannot download $base/checksums.txt"

    line=$(awk -v name="$archive" '{ n = $2; sub(/^\*/, "", n); if (n == name) print }' "$tmp/checksums.txt")
    [ -n "$line" ] || die "checksums.txt has no entry for $archive"
    printf '%s\n' "$line" >"$tmp/expected"
    (cd "$tmp" && verify) >/dev/null || die "cannot verify $archive; nothing was installed"

    mkdir "$tmp/out"
    tar -xzf "$tmp/$archive" -C "$tmp/out" dotman || die "cannot extract dotman from $archive"
    mkdir -p "$bin_dir"
    # The rename is atomic, so an interrupted copy never leaves a truncated file named dotman.
    staged=$bin_dir/.dotman.$$
    if ! { cp "$tmp/out/dotman" "$staged" && chmod 0755 "$staged" && mv -f "$staged" "$bin_dir/dotman"; }; then
        die "cannot install dotman into $bin_dir"
    fi
    staged=
}

parse_semver "$pinned"
want_major=$major
want_minor=$minor
want_patch=$patch

dotman=
for candidate in "$bin_dir/dotman" "$(command -v dotman || true)"; do
    case $candidate in
        /*) ;;
        *) continue ;;
    esac
    if is_current_dotman "$candidate"; then
        dotman=$candidate
        break
    fi
done
if [ -z "$dotman" ]; then
    install_dotman
    dotman=$bin_dir/dotman
fi

# `dot` is only ever an alias. Graphviz or another tool may own the name, and ~/.local/bin is often
# not on PATH yet, so a file already there counts too: nothing is replaced or shadowed.
add_alias() {
    if [ "$(readlink "$bin_dir/dot" 2>/dev/null || true)" = dotman ]; then
        return 0
    fi
    if command -v dot >/dev/null 2>&1 || [ -e "$bin_dir/dot" ] || [ -L "$bin_dir/dot" ]; then
        echo "install.sh: dot is already taken, so dotman is the command" >&2
    elif ln -s dotman "$bin_dir/dot" 2>/dev/null; then
        echo "install.sh: dot is an alias for dotman" >&2
    else
        echo "install.sh: could not add the dot alias, so dotman is the command" >&2
    fi
}

if [ "$dotman" = "$bin_dir/dotman" ]; then
    add_alias
fi

DOTMAN_NON_INTERACTIVE=1
export DOTMAN_NON_INTERACTIVE
if [ "$(id -u)" = 0 ]; then
    DOTMAN_ALLOW_ROOT=1
    export DOTMAN_ALLOW_ROOT
fi
# A rerun must not clobber edits: with a repo present, apply skips conflicting files when
# non-interactive, where init --take-repo would overwrite them.
if "$dotman" status >/dev/null 2>&1; then
    set -- apply
else
    set -- init "$dir" --take-repo
fi

# Sets code. With DOTMAN_APPROVE_HOOKS=1 it adds --approve-hooks and holds dotman's stderr in said
# until dotman exits, so the script can read whether the approval approved nothing. The stderr goes
# to a file, not a pipe: a hook's background process inherits it and would hold a pipe open.
run_dotman() {
    code=0
    said=
    if [ "${DOTMAN_APPROVE_HOOKS:-}" = 1 ]; then
        said_file=$(make_temp) || die "cannot create a temp file"
        "$dotman" "$@" --approve-hooks 2>"$said_file" || code=$?
        said=$(cat "$said_file")
        rm -f "$said_file"
        said_file=
        [ -z "$said" ] || printf '%s\n' "$said" >&2
    else
        "$dotman" "$@" || code=$?
    fi
}

approved_nothing() {
    [ "$code" = 3 ] || return 1
    case $said in
        *"--approve-hooks approved nothing"*) return 0 ;;
        *) return 1 ;;
    esac
}

run_dotman "$@"
# DOTMAN_APPROVE_HOOKS=1 trusts the repo's hooks. When the table changed since this machine last
# showed one, the first run only shows and records the current table, and a second approves it.
# There is no third: a table that changes again is not approved.
if approved_nothing; then
    echo "install.sh: DOTMAN_APPROVE_HOOKS=1, so the [hooks] table shown above is approved now" >&2
    run_dotman apply
    if approved_nothing; then
        die "the repo's hooks are not approved: the [hooks] table changed again; read it, then run: dotman apply --approve-hooks"
    fi
    case $code in
        0 | 3) ;;
        *)
            echo "install.sh: dotman apply --approve-hooks failed (exit $code), so the repo's hooks may not be approved" >&2
            exit "$code"
            ;;
    esac
fi
# Exit 3 means some paths need attention after a successful init. A nonzero exit would make
# DevPod run the next candidate script on top of this one.
case $code in
    0 | 3) exit 0 ;;
    *) exit "$code" ;;
esac
